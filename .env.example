# Copy to .env and fill in.

# Password for the noVNC viewer (required)
VNC_PASSWORD=change-me

# IP on the Docker host to publish CDP (9222) and noVNC (6080) on.
# 127.0.0.1 = this machine only. Use the host's LAN IP so the Hermes LXC can connect.
BIND_IP=127.0.0.1

TZ=America/New_York

# Optional
# SCREEN_WIDTH=1920
# SCREEN_HEIGHT=1080
# CHROME_EXTRA_FLAGS=--lang=en-US
